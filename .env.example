# Configurazione Ambiente puulp.it per VPS Hostinger
NODE_ENV="production"
PORT=3000

# URL pubblico del sito (es. https://puulp.it)
APP_URL="https://puulp.it"

# Opzionale: Chiave Gemini API per scraping intelligente o riassunti avanzati
GEMINI_API_KEY=""

# Database Firestore / Firebase:
# Le credenziali Firebase Web client sono già compilate nel codice frontend
# (src/lib/firebase.ts) connesse al database Firestore sicuro.
